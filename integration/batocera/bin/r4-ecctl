#!/bin/sh

EXPECTED_VID="cafe"
EXPECTED_PID="4005"
EXPECTED_SERIAL="R4-0001"

R4_RUNTIME_DIR="${R4_RUNTIME_DIR:-/tmp}"
LOCK_DIR="$R4_RUNTIME_DIR/r4-ecctl.lock"
SERVICE_PID_FILE="$R4_RUNTIME_DIR/r4-controller-service.pid"
BROKER_REQUEST_DIR="$R4_RUNTIME_DIR/r4-controller-requests"
BROKER_RESPONSE_DIR="$R4_RUNTIME_DIR/r4-controller-responses"
LOCK_HELD=0
BROKER_REQUEST_FILE=""
BROKER_RESPONSE_FILE=""

cleanup() {
    if [ "$LOCK_HELD" -eq 1 ]; then
        rm -rf "$LOCK_DIR"
        LOCK_HELD=0
    fi

    if [ -n "$BROKER_REQUEST_FILE" ]; then
        rm -f "$BROKER_REQUEST_FILE"
    fi

    if [ -n "$BROKER_RESPONSE_FILE" ]; then
        rm -f "$BROKER_RESPONSE_FILE"
    fi
}

trap cleanup 0
trap 'exit 1' 1 2 15

acquire_lock() {
    attempt=0
    max_attempts=5

    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        if [ -f "$LOCK_DIR/pid" ]; then
            lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)"

            if [ -n "$lock_pid" ] &&
               ! kill -0 "$lock_pid" 2>/dev/null; then
                rm -rf "$LOCK_DIR"
                continue
            fi
        fi

        attempt=$((attempt + 1))

        if [ "$attempt" -ge "$max_attempts" ]; then
            echo "R4 service channel is busy" >&2
            return 1
        fi

        sleep 1
    done

    printf '%s\n' "$$" > "$LOCK_DIR/pid"
    LOCK_HELD=1
}

find_r4_port() {
    for device in /dev/ttyACM*; do
        [ -e "$device" ] || continue

        properties="$(
            udevadm info \
                --query=property \
                --name="$device" \
                2>/dev/null
        )"

        vid="$(
            printf '%s\n' "$properties" |
                sed -n 's/^ID_VENDOR_ID=//p'
        )"

        pid="$(
            printf '%s\n' "$properties" |
                sed -n 's/^ID_MODEL_ID=//p'
        )"

        serial="$(
            printf '%s\n' "$properties" |
                sed -n 's/^ID_SERIAL_SHORT=//p'
        )"

        interface="$(
            printf '%s\n' "$properties" |
                sed -n 's/^ID_USB_INTERFACE_NUM=//p'
        )"

        if [ "$vid" = "$EXPECTED_VID" ] &&
           [ "$pid" = "$EXPECTED_PID" ] &&
           [ "$serial" = "$EXPECTED_SERIAL" ] &&
           [ "$interface" = "00" ]; then
            printf '%s\n' "$device"
            return 0
        fi
    done

    return 1
}

submit_to_service() {
    broker_command="$1"

    [ -f "$SERVICE_PID_FILE" ] || return 3
    service_pid="$(cat "$SERVICE_PID_FILE" 2>/dev/null)"

    [ -n "$service_pid" ] &&
        kill -0 "$service_pid" 2>/dev/null ||
        return 3

    [ -d "$BROKER_REQUEST_DIR" ] &&
        [ -d "$BROKER_RESPONSE_DIR" ] ||
        return 3

    request_id="$$"
    request_temp="$BROKER_REQUEST_DIR/.request.$request_id"
    BROKER_REQUEST_FILE="$BROKER_REQUEST_DIR/request.$request_id"
    BROKER_RESPONSE_FILE="$BROKER_RESPONSE_DIR/response.$request_id"

    rm -f \
        "$request_temp" \
        "$BROKER_REQUEST_FILE" \
        "$BROKER_RESPONSE_FILE"

    printf '%s\n' "$broker_command" > "$request_temp" ||
        return 3
    mv "$request_temp" "$BROKER_REQUEST_FILE" ||
        return 3

    attempt=0

    while [ ! -f "$BROKER_RESPONSE_FILE" ]; do
        attempt=$((attempt + 1))

        if [ "$attempt" -ge 100 ] ||
           ! kill -0 "$service_pid" 2>/dev/null; then
            echo "R4 controller service response timeout" >&2
            return 2
        fi

        sleep 0.05
    done

    broker_status="$(
        sed -n '1p' "$BROKER_RESPONSE_FILE"
    )"
    broker_response="$(
        sed -n '2p' "$BROKER_RESPONSE_FILE"
    )"

    rm -f "$BROKER_RESPONSE_FILE"
    BROKER_REQUEST_FILE=""
    BROKER_RESPONSE_FILE=""

    if [ "$broker_status" = "OK" ]; then
        printf '%s\n' "$broker_response"
        return 0
    fi

    if [ -n "$broker_response" ]; then
        printf '%s\n' "$broker_response" >&2
    else
        echo "R4 controller service rejected command" >&2
    fi

    return 1
}

framebuffer_mode=0
framebuffer_previous_hash=""

if [ "${1:-}" = "--framebuffer" ]; then
    [ "$#" -le 2 ] || {
        echo "Usage: $0 --framebuffer [PREVIOUS_HASH]" >&2
        exit 1
    }
    framebuffer_mode=1
    framebuffer_previous_hash="${2:-}"

    if [ -n "$framebuffer_previous_hash" ] &&
       ! printf '%s\n' "$framebuffer_previous_hash" |
           grep -Eq '^[0-9A-Fa-f]{8}$'; then
        echo "Previous framebuffer hash must be 8 hexadecimal digits" >&2
        exit 1
    fi

    command="FRAMEBUFFER READ"
    [ -z "$framebuffer_previous_hash" ] ||
        command="$command HASH=$framebuffer_previous_hash"
elif [ "$#" -eq 0 ]; then
    command="PING"
else
    command="$*"
fi

command_length="$(printf '%s' "$command" | wc -c)"

if [ "$command_length" -lt 1 ] ||
   [ "$command_length" -gt 255 ]; then
    echo "R4 embedded controller command must be 1..255 bytes" >&2
    exit 1
fi

if [ "${R4_ECCTL_DIRECT:-0}" != "1" ]; then
    submit_to_service "$command"
    broker_result=$?

    if [ "$broker_result" -ne 3 ]; then
        exit "$broker_result"
    fi

    if [ "${R4_ECCTL_BROKER_ONLY:-0}" = "1" ]; then
        echo "R4 controller broker is unavailable" >&2
        exit 1
    fi
fi

acquire_lock || exit 1

port="$(find_r4_port)" || {
    echo "R4 embedded controller not found" >&2
    exit 1
}

stty -F "$port" 115200 raw -echo || {
    echo "Unable to configure $port" >&2
    exit 1
}

exec 3<>"$port" || {
    echo "Unable to open $port" >&2
    exit 1
}

controller_transact() {
    printf '%s\r\n' "$1" >&3 || return 1

    transaction_response="$(timeout 2 head -n 1 <&3)" ||
        return 1
    [ -n "$transaction_response" ] || return 1

    printf '%s' "$transaction_response" |
        tr -d '\r'
}

if [ "$framebuffer_mode" -eq 1 ]; then
    info_response="$(controller_transact "FRAMEBUFFER INFO")" || {
        echo "R4 framebuffer info timeout" >&2
        exit 1
    }

    case "$info_response" in
        "FRAMEBUFFER INFO "*)
            ;;
        *)
            echo "Invalid RP2040 framebuffer info: $info_response" >&2
            exit 1
            ;;
    esac

    snapshot_id="$(
        printf '%s\n' "$info_response" |
            sed -n 's/.* ID=\([0-9][0-9]*\) .*/\1/p'
    )"
    width="$(
        printf '%s\n' "$info_response" |
            sed -n 's/.* WIDTH=\([0-9][0-9]*\) .*/\1/p'
    )"
    height="$(
        printf '%s\n' "$info_response" |
            sed -n 's/.* HEIGHT=\([0-9][0-9]*\) .*/\1/p'
    )"
    byte_count="$(
        printf '%s\n' "$info_response" |
            sed -n 's/.* BYTES=\([0-9][0-9]*\) .*/\1/p'
    )"
    framebuffer_hash="$(
        printf '%s\n' "$info_response" |
            sed -n 's/.* HASH=\([0-9A-Fa-f][0-9A-Fa-f]*\) .*/\1/p'
    )"
    chunk_max="$(
        printf '%s\n' "$info_response" |
            sed -n 's/.* CHUNK_MAX=\([0-9][0-9]*\)$/\1/p'
    )"

    if [ -z "$snapshot_id" ] ||
       [ -z "$width" ] ||
       [ -z "$height" ] ||
       [ -z "$byte_count" ] ||
       [ -z "$framebuffer_hash" ] ||
       [ -z "$chunk_max" ] ||
       [ "$byte_count" -lt 1 ] ||
       [ "$byte_count" -gt 4096 ] ||
       [ "$chunk_max" -lt 1 ] ||
       [ "$chunk_max" -gt 96 ]; then
        echo "Invalid RP2040 framebuffer geometry" >&2
        exit 1
    fi

    if [ -n "$framebuffer_previous_hash" ] &&
       [ "$framebuffer_hash" = "$framebuffer_previous_hash" ]; then
        printf 'FRAMEBUFFER UNCHANGED HASH=%s\n' \
            "$framebuffer_hash"
        exit 0
    fi

    offset=0
    framebuffer_hex=""

    while [ "$offset" -lt "$byte_count" ]; do
        length="$chunk_max"
        remaining=$((byte_count - offset))
        [ "$length" -le "$remaining" ] ||
            length="$remaining"

        chunk_response="$(
            controller_transact \
                "FRAMEBUFFER CHUNK ID=$snapshot_id OFFSET=$offset LENGTH=$length"
        )" || {
            echo "R4 framebuffer chunk timeout at offset $offset" >&2
            exit 1
        }

        chunk_hex="$(
            printf '%s\n' "$chunk_response" |
                sed -n \
                    "s/^FRAMEBUFFER DATA ID=$snapshot_id OFFSET=$offset LENGTH=$length HEX=//p"
        )"
        chunk_hex_length="$(printf '%s' "$chunk_hex" | wc -c)"

        if [ "$chunk_hex_length" -ne $((length * 2)) ] ||
           ! printf '%s\n' "$chunk_hex" |
               grep -Eq '^[0-9A-Fa-f]+$'; then
            echo "Invalid RP2040 framebuffer chunk at offset $offset" >&2
            exit 1
        fi

        framebuffer_hex="${framebuffer_hex}${chunk_hex}"
        offset=$((offset + length))
    done

    printf \
        'FRAMEBUFFER FULL WIDTH=%s HEIGHT=%s FORMAT=MONO1_MSB BYTES=%s HASH=%s HEX=%s\n' \
        "$width" \
        "$height" \
        "$byte_count" \
        "$framebuffer_hash" \
        "$framebuffer_hex"
    exit 0
fi

printf '%s\r\n' "$command" >&3

response="$(timeout 2 head -n 1 <&3)"
read_status=$?

exec 3>&-

if [ "$read_status" -eq 0 ] && [ -n "$response" ]; then
    response="$(printf '%s' "$response" | tr -d '\r')"
    printf '%s\n' "$response"
else
    echo "R4 embedded controller response timeout" >&2
    exit 1
fi
